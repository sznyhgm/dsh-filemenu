{
  "name": "dsh-filemenu",
  "version": "1.2.0",
  "description": "Right-click context menus for file paths, links, and sidebar rows in the DeepSeek Harness (DSH) web UI: open a path, reveal it in Explorer/Finder, open it in a detected editor, copy absolute/relative paths and links. 对话里的文件路径与链接右键菜单。",
  "license": "MIT",
  "author": "sznyhgm",
  "contributors": [
    "ltsone9 (original dsh-filemenu)"
  ],
  "homepage": "https://github.com/sznyhgm/dsh-filemenu",
  "repository": {
    "type": "git",
    "url": "https://github.com/sznyhgm/dsh-filemenu.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "context-menu",
    "file-menu",
    "right-click"
  ],
  "engines": {
    "node": ">=18"
  }
}
